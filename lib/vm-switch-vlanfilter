# create bridge interface for a vlanfilter switch
#
# @param string _name name of the switch
#
switch::vlanfilter::init()
{
    local _name="$1"
    local _id _addr _mtu _len _ifconf

    # see if it is supported
    switch::vlanfilter::supported

    # see if it already exists
    switch::vlanfilter::id "_id" "${_name}" && return 0

    # get the length of the switch name
    # it's useful for other utilities to use switch name as interface name
    # as it's static. can't do that if it's > 12 chars
    _len=$(echo -n "${_name}" | wc -m)

    if [ ${_len} -le 12 ]; then
      _ifconf="name vm-${_name}"
    else
      _ifconf="descr vm/${_name}"
    fi

    # create a bridge for this switch
    _id=$(ifconfig bridge create ${_ifconf} vlanfilter group vm-switch up 2>/dev/null)
    [ $? -eq 0 ] || util::err "failed to create bridge interface for switch ${_name}"

    switch::set_viid "${_name}" "${_id}"

    # randomise mac
    ifconfig "${_id}" link random

    # try to set ip address
    #config::core::get "_addr" "addr_${_name}"
    #[ -n "${_addr}" ] && ifconfig "${_id}" inet ${_addr} 2>/dev/null
    #config::core::get "_addr" "addr6_${_name}"
    #[ -n "${_addr}" ] && ifconfig "${_id}" inet6 ${_addr} auto_linklocal 2>/dev/null

    # custom mtu?
    config::core::get "_mtu" "mtu_${_name}"
    [ -n "${_mtu}" ] && ifconfig "${_id}" mtu ${_mtu}

    # add member interfaces
    switch::vlanfilter::__add_members "${_name}" "${_id}"

}

# show the configuration details for a switch
#
# @param string _name the switch name
# @param string _format output format
#
switch::vlanfilter::show(){
    local _name="$1"
    local _format="$2"
    local _id _ports _addr _addr6 _mtu _priv _tagged _untagged _vlans

    switch::find "_id" "${_name}"
    config::core::get "_ports" "ports_${_name}"
    config::core::get "_addr" "addr_${_name}"
    config::core::get "_addr6" "addr6_${_name}"
    config::core::get "_mtu" "mtu_${_name}"
    config::core::get "_priv" "private_${_name}" "no"
    config::core::get "_tagged" "vlanfilter_tagged_${_name}" "all"
    config::core::get "_untagged" "vlanfilter_untagged_${_name}"

    _vlans="${_tagged}"

    if [ -n "${_addr}" -a -n "${_addr6}" ]; then
      # if the interface has both IPv4 and IPv6 addresses, print IPv4 first
      printf "${_format}" "${_name}" "vlanfilter" "${_id:--}" "${_addr:--}" "${_priv}" "${_mtu:--}" \
        "${_vlans:--}" "${_ports:--}"

      # and IPv6 next
      printf "${_format}" \
                "$(util::pad_spaces "${_name}")" "$(util::pad_spaces "vlanfilter")" \
                "$(util::pad_spaces "${_id}")" "${_addr6}" \
                "$(util::pad_spaces "${_priv}")" "$(util::pad_spaces "${_mtu}")" \
                "$(util::pad_spaces "${_vlans}")" "$(util::pad_spaces "${_ports}")"
    else
      printf "${_format}" "${_name}" "vlanfilter" "${_id:--}" "${_addr:-${_addr6:--}}" "${_priv}" \
        "${_mtu:--}" "${_vlans:--}" "${_ports:--}"
    fi
}

# create a vlanfilter virtual switch
#
switch::vlanfilter::create(){
    # see if it is supported
    switch::vlanfilter::supported

    # store configuration
    config::core::set "switch_list" "${_switch}" "1"
    config::core::set "type_${_switch}" "vlanfilter"
    config::core::set "vlanfilter_tagged_${_switch}" "${_tagged:-all}"
    config::core::set "vlanfilter_untagged_${_switch}" "${_untagged}"

    [ -n "${_if}" ] && config::core::set "ports_${_switch}" "${_if}"
    [ -n "${_priv}" ] && config::core::set "private_${_switch}" "${_priv}"
    [ -n "${_mtu}" ] && config::core::set "mtu_${_switch}" "${_mtu}"
    case "${_addr}" in
        "") ;;
        *:*) config::core::set "addr6_${_switch}" "${_addr}" ;; # IPv6
        *) config::core::set "addr_${_switch}" "${_addr}" ;; # IPv4
    esac

    config::core::load
    switch::vlanfilter::init "${_switch}"
}

# destroy a vlanfilter switch
#
# @param string _switch name of the switch to destroy
#
switch::vlanfilter::remove(){
    local _switch="$1"
    local _id

    # get the bridge id
    switch::vlanfilter::id "_id" "${_switch}"
    [ $? -eq 0 ] || return 1

    # remove all member interfaces
    switch::vlanfilter::__remove_members "${_switch}" "${_id}"

    # destroy the bridge
    ifconfig "${_id}" destroy >/dev/null 2>&1
}

# add a new interface to this switch
#
# @param string _switch name of the switch
# @param string _if the interface to add
#
switch::vlanfilter::add_member(){
    local _switch="$1"
    local _if="$2"
    local _id _vlan _mtu
    local _tagged # tagged vlan-list for vlanfilter
    local _untagged # untagged vlan-list for vlanfilter

    switch::vlanfilter::id "_id" "${_switch}" || util::err "unable to locate switch id"
    config::core::get "_vlan" "vlan_${_switch}"
    config::core::get "_mtu" "mtu_${_switch}"
    config::core::get "_tagged" "vlanfilter_tagged_${_switch}" "all"
    config::core::get "_untagged" "vlanfilter_untagged_${_switch}"
    switch::vlanfilter::__configure_port "${_switch}" "${_id}" "${_if}" "${_tagged}" "${_untagged}" "${_mtu}"
    config::core::set "ports_${_switch}" "${_if}" "1"
}

# remove a member interface from this switch
#
# @param string _switch name of the switch
# @param string _if the interface to remove
#
switch::vlanfilter::remove_member(){
    local _switch="$1"
    local _if="$2"
    local _id

    switch::vlanfilter::id "_id" "${_switch}" || util::err "unable to locate switch id"
    config::core::remove "ports_${_switch}" "${_if}"
    switch::vlanfilter::__unconfigure_port "${_switch}" "${_id}" "${_if}"
}

# set vlan id
#
# @param string _switch name of switch
# @param int _vlan vlan id to set
#
switch::vlanfilter::vlan(){
    local _switch="$1"
    local _vlan="$2"
    local _id

    switch::vlanfilter::id "_id" "${_switch}" || util::err "unable to locate switch id"
    switch::vlanfilter::__remove_members "${_switch}" "${_id}"

    # update configuration
    if [ "${_vlan}" = "0" ]; then
        config::core::remove "vlan_${_switch}"
    else
        config::core::set "vlan_${_switch}" "${_vlan}"
    fi

    config::core::load
    switch::vlanfilter::__add_members "${_switch}" "${_id}"
}

# set or remove ip address
#
# @param string _switch name of the switch
# @param string _addr address or "none"
# @scope _id switch if from parent switch::address
#
switch::vlanfilter::address(){
    local _switch="$1"
    local _vlan="$2"
    local _addr="$3"
    local _delete="$4"
    local _curr _curr6

    #util::err "assigning ip address to vlanfilter switch is not supported"

    # validate vlan id
    if [ -n "${_vlan}" ]; then
        echo "${_vlan}" | egrep -qs '^[0-9]{1,4}$'
        [ $? -eq 0 ] || util::err "invalid vlan number"
        [ ${_vlan} -ge 4095 ] && util::err "invalid vlan number"
    fi

    if [ "${_delete}" = "delete" ]; then
        # delete specified address
        config::core::get "_curr" "addr_${_switch}_${_vlan}"
        config::core::get "_curr6"  "addr6_${_switch}_${_vlan}"

        case "${_addr}" in
            "${_curr}")
                config::core::remove "addr_${_switch}_${_vlan}"
                ifconfig "${_id}.${_vlan}" inet "${_curr}" delete
                ;;
            "${_curr6}")
                config::core::remove "addr6_${_switch}_${_vlan}"
                ifconfig "${_id}.${_vlan}" inet6 "${_curr6}" delete
                ;;
            *)
                util::err "specified address ${_addr} is not assigned to this switch"
                ;;
        esac

        return 0;
    fi

    config::core::get "_curr" "addr_${_switch}_${_vlan}"
    config::core::get "_curr6"  "addr6_${_switch}_${_vlan}"

    if [ "${_addr}" = "none" ]; then # remove all ip addresses

        [ -z "${_curr}" -a -z "${_curr6}" ] && \
            util::err "unable to locate an existing address for this switch"

        if [ -n "${_curr}" ]; then
            config::core::remove "addr_${_switch}_${_vlan}"
            ifconfig "${_id}.${_vlan}" inet "${_curr}" delete
        fi

        if [ -n "${_curr6}" ]; then
            config::core::remove "addr6_${_switch}_${_vlan}"
            ifconfig "${_id}.${_vlan}" inet6 "${_curr6}" delete
        fi
    else
        # add ip address
        case "${_addr}" in
            *:*) # IPv6
                [ "${_curr6}" = "${_addr}" ] &&  util::err "The specified IP address is already assigned to this switch."
                [ -n "${_curr6}" ] && { util::confirm "This switch already has ${_curr6} assigned, replace it?" || exit 0; }
                config::core::set "addr6_${_switch}_${_vlan}" "${_addr}"
                ifconfig "${_id}.${_vlan}" create inet6 "${_addr}" auto_linklocal
                # remove the previous IPv6 address
                # because the current config::core design assumes a single IPv6 address per a switch
                [ -n "${_curr6}" ] && ifconfig "${_id}_${_vlan}" inet6 "${_curr6}" delete
                ;;
            *) # IPv4
                [ "${_curr}" = "${_addr}" ] &&  util::err "The specified IP address is already assigned to this switch."
                [ -n "${_curr}" ] && { util::confirm "This switch already has ${_curr} assigned, replace it?" || exit 0; }
                config::core::set "addr_${_switch}_${_vlan}" "${_addr}"
                ifconfig "${_id}.${_vlan}" inet "${_addr}"
                ;;
        esac
    fi
}

# add all member interfaces to a switch
#
# @param string _switch the name of the switch
# @param string _id interface id for the switch
#
switch::vlanfilter::__add_members(){
    local _switch="$1"
    local _id="$2"
    local _ports _vlan _port _mtu

    # get the id if not provided
    if [ -z "${_id}" ]; then
        switch::vlanfilter::id "_id" "${_switch}" || util:err "failed to get switch id while adding members"
    fi

    config::core::get "_ports" "ports_${_switch}"
    config::core::get "_vlan" "vlan_${_switch}"
    config::core::get "_mtu" "mtu_${_switch}"
    config::core::get "_tagged" "vlanfilter_tagged_${_switch}" "all"
    config::core::get "_untagged" "vlanfilter_untagged_${_switch}"

    if [ -n "${_ports}" ]; then
        for _port in ${_ports}; do
            switch::vlanfilter::__configure_port "${_switch}" "${_id}" "${_port}" "${_tagged}" "${_untagged}" "${_mtu}"
        done
    fi
}

# remove member interfaces from a switch
#
# @param string _switch the name of the switch
# @param string _id bridge id if already known
#
switch::vlanfilter::__remove_members(){
    local _switch="$1"
    local _id="$2"
    local _ports _port

    # get id if not given to us
    if [ -z "${_id}" ]; then
        switch::vlanfilter::id "_id" "${_switch}"
        [ $? -eq 0 ] || util::err "failed to get switch id while removing members"
    fi

    # get full ort list
    config::core::get "_ports" "ports_${_switch}"
    config::core::get "_vlan" "vlan_${_switch}"

    if [ -n "${_ports}" ]; then
        for _port in ${_ports}; do
           switch::vlanfilter::__unconfigure_port "${_switch}" "${_id}" "${_port}"
        done
    fi
}

# configure a local port for our bridge
#
# @param string _switch the switch to add port to
# @param string _id the bridge id of the switch
# @param string _port the interface to add
# @param string _tagged tagged vlan-list
# @param string _untagged untagged vlan-list
# @param int _mtu custom mtu to use for this port
#
switch::vlanfilter::__configure_port(){
    local _switch="$1"
    local _id="$2"
    local _port="$3"
    local _tagged="$4"
    local _untagged="$5"
    local _mtu="$6"
    local _viface _vname

    # try to set mtu of port?
    [ -n "${_mtu}" ] && ifconfig "${_port}" mtu ${_mtu} >/dev/null 2>&1

    # add to vlanfilter bridge
    ifconfig ${_id} addm ${_port} >/dev/null 2>&1
    [ $? -eq 0 ] || util::err "failed to add member ${_port} to the virtual switch ${_switch}"

    # configure tagged vlans
    if [ -n "${_tagged}" ]; then
        ifconfig ${_id} iftagged ${_port} "${_tagged}" >/dev/null 2>&1
        [ $? -eq 0 ] || util::err "failed to configure iftagged on the vlanfilter switch ${_switch}"
    fi

    # configure untagged vlans
    if [ -n "${_untagged}" ]; then
        ifconfig ${_id} ifuntagged "${_port}" "${_untagged}" >/dev/null 2>&1
        [ $? -eq 0 ] || util::err "failed to configure ifuntagged on the vlanfilter switch ${_switch}"
    fi
}

# unconfigure a local port
#
# @param string _switch the switch to remove port from
# @param string _id the bridge id of the switch
# @param string _port the interface to remove
# @param string _vlan vlan number if assigned to this switch
#
switch::vlanfilter::__unconfigure_port(){
    local _switch="$1"
    local _id="$2"
    local _port="$3"

    ifconfig ${_id} deletem ${_port} >/dev/null 2>&1
}

# get the id for a vlanfilter switch
# this returns the associated bridge name
#
# @param string _var variable to put id into
# @param string _switch the switch to look for
# @return 0 on success
#
switch::vlanfilter::id(){
    switch::find "$1" "$2"
}

# creates a vlanfilter tap interface for a guest
# relies heavily on variables set in the main vm::run function
#
# @modifies _func _devices
# @return 1 if we don't get a tap device
#
switch::vlanfilter::provision(){
    local _tap _custom_tap _sid _mtu _member_type _iname

    config::get "_custom_tap" "network${_num}_device"
    config::get "_iname" "network${_num}_name"
    config::get "_untagged" "network${_num}_vlan_untagged"
    config::get "_tagged" "network${_num}_vlan_tagged"

    # create interface
    if [ -n "${_custom_tap}" ]; then
        _tap="${_custom_tap}"
    elif [ -n "${_iname}" ]; then
        _tap=$(ifconfig tap create name "${_iname}")
    else
        _tap=$(ifconfig tap create)
    fi

    [ -z "${_tap}" ] && return 1;

    util::log "guest" "${_name}" "initialising network device ${_tap}"
    ifconfig "${_tap}" descr "vmnet/${_name}/${_num}/${_switch:-custom}" group vm-port >/dev/null 2>&1

    if [ -n "${_switch}" ]; then
        switch::id "_sid" "${_switch}"

        # should this be a span member?
        _member_type="addm"
        config::yesno "network${_num}_span" && _member_type="span"

        if [ -n "${_sid}" ]; then
            _mtu=$(ifconfig "${_sid}" | head -n1 | awk '{print $NF}')

            if [ "${_mtu}" != "1500" ]; then
                util::log "guest" "${_name}" "setting mtu of ${_tap} to ${_mtu}"
                ifconfig "${_tap}" mtu "${_mtu}" >/dev/null 2>&1
            fi

            util::log "guest" "${_name}" "adding ${_tap} -> ${_sid} (${_switch} ${_member_type})"
            ifconfig "${_sid}" "${_member_type}" "${_tap}" >/dev/null 2>&1 || util::log "guest" "${_name}" "failed to add ${_tap} to ${_sid}"

            if [ -n "${_untagged}" ]; then
                util::log "guest" "${_name}" "configuring vlan on ${_tap} -> untagged ${_untagged}"
                ifconfig "${_sid}" ifuntagged "${_tap}" "${_untagged}" >/dev/null 2>&1 || \
                    util::log "guest" "${_name}" "failed to configure untagged vlan ${_untagged}"
            fi

            if [ -n "${_tagged}" ]; then
                util::log "guest" "${_name}" "configuring vlan on ${_tap} -> tagged ${_tagged}"
                ifconfig "${_sid}" iftagged "${_tap}" "${_tagged}" >/dev/null 2>&1 || \
                    util::log "guest" "${_name}" "failed to configure tagged vlan ${_tagged}"
            fi

            util::log "guest" "${_name}" "bring up ${_tap} -> ${_sid} (${_switch} ${_member_type})"
            ifconfig "${_tap}" up >/dev/null 2>&1 || util::log "guest" "${_name}" "failed to bring up ${_tap} in ${_sid}"

            # set private if configured
            switch::is_private "${_switch}" && ifconfig "${_sid}" "private" "${_tap}" >/dev/null 2>&1
        else
            util::log "guest" "${_name}" "failed to find virtual switch '${_switch}'"
        fi
    fi

    _devices="${_devices} -s ${_bus}:${_slot}:${_func},${_emulation},${_tap}"
    [ -n "${_mac}" ] && _devices="${_devices},mac=${_mac}"

    _func=$((_func + 1))
    [ -z "${_custom_tap}" ] && _taplist="${_taplist}${_taplist:+ }${_tap}"
}

#
# check if vlanfilter is supported
#
switch::vlanfilter::supported()
{
    [ ${VERSION_BSD} -lt 1500000 ] && \
        util::err "vlanfilter switch (VLAN filtering bridge) requires FreeBSD 15.0 or later"
}
