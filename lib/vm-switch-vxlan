# create a vxlan switch
# we create a bridge and then add the vxlan interface to it
#
# @param string _name name of the switch
#
switch::vxlan::init(){
    local _name="$1"
    local _id _vlan _if _maddr _addr _ifconf _fib _tunnelfib _vxif

    # see if the bridge already exists
    switch::standard::id "_id" "${_name}" && return 0

    # need a vlan id and interface
    config::core::get "_vlan" "vlan_${_name}"
    config::core::get "_if" "ports_${_name}"
    [ -z "${_vlan}" -o -z "${_if}" ] && return 1

    config::core::get "_fib" "fib_${_name}"
    config::core::get "_tunnelfib" "tunnelfib_${_name}" "${_fib}"

    # get local address for this interface
    _local=$(ifconfig ${_if} | grep "inet " | cut -d" " -f 2)
    [ -z "${_local}" ] && return 1

    # come up with an ip address for multicast data
    switch::vxlan::__multicast "_maddr" "${_name}"

    # create the vxlan interface
    _vxif="vxlan${_vlan}"
    ifconfig "${_vxif}" create vxlanid "${_vlan}" vxlanlocal "${_local}" vxlangroup "${_maddr}" \
      vxlandev "${_if}" descr "vm-vxlan/${_switch}" group vm-vlan up >/dev/null 2>&1
    [ $? -eq 0 ] || return 1

    [ -n "${_fib}" ] && ifconfig "${_vxif}" fib "${_fib}" >/dev/null 2>&1
    [ -n "${_tunnelfib}" ] && ifconfig "${_vxif}" tunnelfib "${_tunnelfib}" >/dev/null 2>&1

    # get the length of the switch name
    # it's useful for other utilities to use switch name as interface name
    # as it's static. can't do that if it's > 12 chars
    _len=$(echo -n "${_name}" | wc -m)

    if [ ${_len} -le 12 ]; then
      _ifconf="name vm-${_name}"
    else
      _ifconf="descr vm/${_name}"
    fi

    # create a bridge for this switch
    _id=$(ifconfig bridge create ${_ifconf} group vm-switch up 2>/dev/null)
    [ $? -eq 0 ] || util::err "failed to create bridge interface for switch ${_name}"

    switch::set_viid "${_name}" "${_id}"

    # set the switch FIB
    [ -n "${_fib}" ] && ifconfig "${_id}" fib "${_fib}" >/dev/null 2>&1

    # randomise mac
    ifconfig "${_id}" link random

    # bridge vxlan to our guest switch
    # static route traffic for this multicast address via our specified interface
    ifconfig "${_id}" addm "${_vxif}"
    switch::vxlan::__route "${_name}" add "${_tunnelfib}"

    # custom address for bridge?
    config::core::get "_addr" "addr_${_name}"
    [ -n "${_addr}" ] && ifconfig "${_id}" inet ${_addr}
}

# show the configuration details for a vxlan switch
#
# @param string _name the switch name
# @param string _format output format
#
switch::vxlan::show(){
    local _name="$1"
    local _format="$2"
    local _id _vlan _port _addr _priv _fib _tunnelfib _fibout

    switch::standard::id "_id" "${_name}"
    config::core::get "_vlan" "vlan_${_name}"
    config::core::get "_port" "ports_${_name}"
    config::core::get "_addr" "addr_${_name}"
    config::core::get "_priv" "private_${_name}" "no"
    config::core::get "_fib" "fib_${_name}"
    config::core::get "_tunnelfib" "tunnelfib_${_name}" "${_fib}"

    if [ -z "${_fib}" ]; then
        _fibout="-"
        [ -n "${_tunnelfib}" ] && _fibout="-/${_tunnelfib}"
    elif [ -n "${_tunnelfib}" -a "${_tunnelfib}" != "${_fib}" ]; then
        _fibout="${_fib}/${_tunnelfib}"
    else
        _fibout="${_fib}"
    fi

    printf "${_format}" "${_name}" "vxlan" "${_id:--}" "${_addr:--}" "${_priv}" "n/a" "${_fibout}" "${_vlan}" "${_port}"
}

# create a vxlan switch
#
switch::vxlan::create(){

    # we must have an interface and vlan to use
    [ -z "${_if}" -o -z "${_vlan}" ] && util::err "vxlan switches must be created with an interface and vlan id specified"

    # store configuration
    config::core::set "switch_list" "${_switch}" "1"
    config::core::set "type_${_switch}" "vxlan"
    config::core::set "vlan_${_switch}" "${_vlan}"
    config::core::set "ports_${_switch}" "${_if}"

    [ -n "${_addr}" ] && config::core::set "addr_${_switch}" "${_addr}"
    [ -n "${_priv}" ] && config::core::set "private_${_switch}" "${_priv}"

    config::core::load
    switch::vxlan::init "${_switch}"
}

# set the fib for a vxlan switch
# this updates the vxlan interface, the bridge and its members
# and moves the multicast route if the tunnel fib follows this fib
#
# @param string _switch name of the switch
# @param int _fib the FIB to use
#
switch::vxlan::fib(){
    local _switch="$1"
    local _fib="$2"
    local _id _vlan _vxif _explicit_tun _old_fib _old_tun _new_tun _addr _addr6

    switch::standard::id "_id" "${_switch}" || util::err "unable to locate switch id"

    config::core::get "_vlan" "vlan_${_switch}"
    config::core::get "_old_fib" "fib_${_switch}"
    config::core::get "_explicit_tun" "tunnelfib_${_switch}"
    config::core::get "_addr" "addr_${_switch}"
    config::core::get "_addr6" "addr6_${_switch}"

    _old_tun="${_explicit_tun:-${_old_fib}}"
    _new_tun="${_explicit_tun:-${_fib}}"
    _vxif="vxlan${_vlan}"

    # remove configured addresses first so their routes are removed
    # from the old FIB before the interface is moved
    [ -n "${_addr}" ] && ifconfig "${_id}" inet "${_addr}" delete >/dev/null 2>&1
    [ -n "${_addr6}" ] && ifconfig "${_id}" inet6 "${_addr6}" delete >/dev/null 2>&1

    ifconfig "${_id}" fib "${_fib}" >/dev/null 2>&1 || \
        util::err "failed to set fib ${_fib} on ${_id}"
    switch::standard::__member_fib "${_id}" "${_fib}"

    if [ -n "${_vlan}" ]; then
        ifconfig "${_vxif}" fib "${_fib}" >/dev/null 2>&1

        if [ "${_old_tun}" != "${_new_tun}" ]; then
            switch::vxlan::__route "${_switch}" del "${_old_tun}"
            ifconfig "${_vxif}" tunnelfib "${_new_tun}" >/dev/null 2>&1
            switch::vxlan::__route "${_switch}" add "${_new_tun}"
        fi
    fi

    # add the addresses back so their routes are created in the new FIB
    [ -n "${_addr}" ] && ifconfig "${_id}" inet "${_addr}" >/dev/null 2>&1
    [ -n "${_addr6}" ] && ifconfig "${_id}" inet6 "${_addr6}" auto_linklocal >/dev/null 2>&1
}

# set the tunnel fib for a vxlan switch
#
# @param string _switch name of the switch
# @param int _tunnelfib the tunnel FIB to use
#
switch::vxlan::tunnelfib(){
    local _switch="$1"
    local _tunnelfib="$2"
    local _id _vlan _vxif _fib _old_tun

    switch::standard::id "_id" "${_switch}" || util::err "unable to locate switch id"

    config::core::get "_vlan" "vlan_${_switch}"
    config::core::get "_fib" "fib_${_switch}"
    config::core::get "_old_tun" "tunnelfib_${_switch}" "${_fib}"

    [ -n "${_vlan}" ] || util::err "unable to locate vxlan interface for switch ${_switch}"
    _vxif="vxlan${_vlan}"

    if [ "${_old_tun}" != "${_tunnelfib}" ]; then
        switch::vxlan::__route "${_switch}" del "${_old_tun}"
        ifconfig "${_vxif}" tunnelfib "${_tunnelfib}" >/dev/null 2>&1
        switch::vxlan::__route "${_switch}" add "${_tunnelfib}"
    fi
}

# add or remove the multicast route for a vxlan switch
#
# @param string _switch name of the switch
# @param string _action add|del
# @param int _fib FIB to use, or empty for the default FIB
#
switch::vxlan::__route(){
    local _switch="$1"
    local _action="$2"
    local _fib="$3"
    local _maddr _if

    switch::vxlan::__multicast "_maddr" "${_switch}"
    config::core::get "_if" "ports_${_switch}"

    if [ "${_action}" = "add" ]; then
        if [ -n "${_fib}" ]; then
            route add -net "${_maddr}/32" -iface "${_if}" -fib "${_fib}" >/dev/null 2>&1
        else
            route add -net "${_maddr}/32" -iface "${_if}" >/dev/null 2>&1
        fi
    else
        if [ -n "${_fib}" ]; then
            route del -net "${_maddr}/32" -fib "${_fib}" >/dev/null 2>&1
        else
            route del -net "${_maddr}/32" >/dev/null 2>&1
        fi
    fi
}

# destroy a vxlan switch
#
# @param string _switch the switch to remove
#
switch::vxlan::remove(){
    local _switch="$1"
    local _id _vlan _fib _tunnelfib

    # try to get guest bridge and vxlan id
    switch::standard::id "_id" "${_switch}"
    [ $? -eq 0 ] || return 1

    config::core::get "_vlan" "vlan_${_switch}"
    [ -z "${_vlan}" ] && return 1

    config::core::get "_fib" "fib_${_switch}"
    config::core::get "_tunnelfib" "tunnelfib_${_switch}" "${_fib}"

    # try to remove any route we may have added
    switch::vxlan::__route "${_switch}" del "${_tunnelfib}"

    # destroy the guest bridge
    ifconfig ${_id} destroy >/dev/null 2>&1
    [ $? -eq 0 ] || return 1

    # destroy the vxlan
    ifconfig "vxlan${_vlan}" destroy >/dev/null 2>&1
}

# add a new interface to this switch
# we only allow a single physical interface for
# vxlan switches. this must be set at creation time
# so this just reports an error
#
# @param string _switch name of the vxlan switch
# @param string _if the interface to add
#
switch::vxlan::add_member(){
    util::err "vxlan interface must be configured at creation time"
}

# remove an interface from a switch
# we don't support this here
#
# @param string _switch name of the switch
# @param string _if the interface to remove
#
switch::vxlan::remove_member(){
    util::err "vxlan interface must be configured at creation time"
}

# set vlan id
#
# @param string _switch name of switch
# @param int _vlan vlan id to set
#
switch::vxlan::vlan(){
    util::err "vxlan id can only be set at creation time"
}

# get the multicast address for a vxlan switch
#
# @param string _var variable to put address into
# @param string _switch the switch name
#
switch::vxlan::__multicast(){
    local _var="$1"
    local _switch="$2"
    local _hash _l_addr _octet _pos

    # come up with an ip address for multicast data
    _hash=$(md5 -qs "${_switch}")
    _l_addr="239"

    for _pos in 1-2 3-4 5-6; do
        _octet=$(printf ".%d" "0x`echo "${_hash}"| cut -c ${_pos}`")
        _l_addr="${_l_addr}${_octet}"
    done

    setvar "${_var}" "${_l_addr}"
}
